{
  "name": "inheritsense",
  "displayName": "InheritSense",
  "description": "Trace JavaScript member origins across class factories and mixins.",
  "version": "1.0.0",
  "publisher": "kuscamara",
  "author": "Kus Cámara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcmr/vsce-inheritsense.git"
  },
  "bugs": {
    "url": "https://github.com/kcmr/vsce-inheritsense/issues"
  },
  "homepage": "https://github.com/kcmr/vsce-inheritsense#readme",
  "keywords": [
    "javascript",
    "inheritance",
    "intellisense",
    "mixins",
    "class factories",
    "class composition",
    "class hierarchy",
    "member origins",
    "go to definition",
    "completion"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#04134E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=24"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:inheritSense.traceSelectedSymbol",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inheritSense.traceSelectedSymbol",
        "title": "InheritSense: Trace Selected Symbol"
      }
    ],
    "configuration": {
      "title": "InheritSense",
      "properties": {
        "inheritSense.completion.enableInheritedSuggestions": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Enable inherited member suggestions for 'this.' completions in JavaScript files."
        },
        "inheritSense.resolution.includeMethodAssignedFields": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "markdownDescription": "Permissive mode: treat assignments like `this.someField = ...` inside non-constructor methods as member declarations during origin/completion resolution. This can improve discovery for dynamic codebases, but may introduce less precise results."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "inheritSense.traceSelectedSymbol",
          "when": "editorTextFocus && (resourceExtname == .js || resourceExtname == .mjs || resourceExtname == .cjs)",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "inheritSense.traceSelectedSymbol",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "tsc -p ./ && node --test test/*.test.mjs",
    "build": "pnpm compile && esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --target=node20 --outfile=dist/extension.js --external:vscode",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package",
    "check:types": "tsc --noEmit -p .",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "vsce": {
    "dependencies": false
  },
  "dependencies": {
    "@babel/parser": "^7.29.14",
    "@babel/types": "^7.29.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "semantic-release": "^24.2.9",
    "semantic-release-vsce": "^6.1.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
